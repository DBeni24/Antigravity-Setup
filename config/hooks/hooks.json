{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NonInteractive -File C:\\Users\\HP\\.gemini\\config\\hooks\\safety-check.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "lint-feedback": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NonInteractive -File C:\\Users\\HP\\.gemini\\config\\hooks\\run-lint.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
